# Bu faylning nusxasini oling va ".env" deb nomlang.
# Keyin qiymatlarni o'zingiznikiga moslab o'zgartiring.

# Flask sessiyalarini himoyalash uchun maxfiy kalit.
# Istalgan uzun va tasodifiy matn bo'lishi mumkin.
SECRET_KEY=bu-yerga-uzun-tasodifiy-matn-yozing

# Ma'lumotlar bazasi manzili.
# Lokal kompyuterda bu qatorni bo'sh qoldirsangiz, SQLite fayl ishlatiladi.
# Railway (PostgreSQL) da esa bu o'zgaruvchi avtomatik to'ldiriladi.
# DATABASE_URL=postgresql://foydalanuvchi:parol@host:port/baza

# Muhit turi: lokalda bo'sh qoldiring (yoki "development"),
# internetga joylaganda (Railway) "production" qiling.
# "production" bo'lsa SECRET_KEY majburiy va cookie'lar xavfsiz (HTTPS) bo'ladi.
APP_ENV=development
